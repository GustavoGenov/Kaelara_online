{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/projeto",
      "dest": "/projeto.html"
    },
    {
      "src": "/sobre",
      "dest": "/sobre.html"
    },
    {
      "src": "/termos",
      "dest": "/termos.html"
    },
    {
      "src": "/politica-de-privacidade",
      "dest": "/politica-de-privacidade.html"
    },
    {
      "src": "/google62kaLeT9Cbih2V6KHKXkv3e2thS6fXOtROjhRANRI_8.html",
      "dest": "/google62kaLeT9Cbih2V6KHKXkv3e2thS6fXOtROjhRANRI_8.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}