# .env.example – preencha com suas chaves de API e configurações

# APIs de IA (gratuitas)
GEMINI_API_KEY=YOUR_GEMINI_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY
GROK_API_KEY=YOUR_GROK_KEY

# Busca web gratuita (SerpAPI ou Bing)
SERPAPI_KEY=YOUR_SERPAPI_KEY   # ou BING_API_KEY=YOUR_BING_KEY

# Supabase (free tier)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Ngrok (free tier)
NGROK_AUTHTOKEN=YOUR_NGROK_TOKEN

# Configurações do Electron
ALLOW_HARDWARE=true   # Kaelara pode acessar hardware, sempre pedindo confirmação
